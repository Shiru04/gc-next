# Plantilla. Copiar a .env.local para desarrollo:
#     cp .env.example .env.local
# En producción estas variables se configuran en el panel del hosting,
# NO en este archivo — Next.js nunca lee .env.example.

# ---- Google Ads ----
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX

# Etiqueta de la acción de conversión PRIMARIA "Form Submit - Website (2026)".
# Google Ads > Objetivos > Conversiones > la acción > Ver fragmento de evento.
NEXT_PUBLIC_GADS_LABEL_FORM=

# Etiquetas SECUNDARIAS (solo observación, nunca para bidding).
# Si se omiten, lib/tracking.ts usa las que trae por defecto.
NEXT_PUBLIC_GADS_LABEL_PHONE_CLICK=
NEXT_PUBLIC_GADS_LABEL_BOOKING_CLICK=

# ---- Google Analytics ----
# Requerido: sin esto ConsentMode no carga gtag.js y no se mide nada.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ---- Sitio y formularios ----
NEXT_PUBLIC_SITE_URL=https://gc-heatingandcooling.com
NEXT_PUBLIC_FORMS_ENDPOINT=https://operations-hub-cb65.onrender.com/api/public/forms
NEXT_PUBLIC_CONTACT_FORM_ID=
